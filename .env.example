# ─── Variables de entorno para docker-compose ────────────────────────────────
# Copiar este archivo como .env y rellenar los valores:
#   cp .env.example .env
#
# IMPORTANTE: nunca commitear el archivo .env con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos
DB_DATABASE=nortcali
DB_USER=nortcali_user
DB_PASSWORD=cambia_esta_contrasena

# JWT — generar un secreto aleatorio de al menos 64 caracteres:
#   openssl rand -base64 64
JWT_SECRET=reemplaza_con_secreto_seguro_de_minimo_64_caracteres_generado_aleatoriamente
